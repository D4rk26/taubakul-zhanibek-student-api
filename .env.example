# Copy to .env and set real values. Never commit .env.
#   cp .env.example .env
# Generate a password, e.g.: openssl rand -hex 24

# Database (used by docker compose for PostgreSQL and the app)
DB_NAME=studentdb
DB_USERNAME=change_me
DB_PASSWORD=change_me

# Only for running the app outside Docker (./gradlew bootRun / java -jar);
# in Docker Compose DB_HOST is "db" and DB_PORT is 5432 (set in docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
SERVER_PORT=8081
