{
  "info": {
    "name": "Taubakul Zhanibek — Student API",
    "description": "Requests for taubakul-zhanibek-student-api (DevOps midterm, author: Taubakul Zhanibek). Run the folder in order: create -> list -> get -> update -> delete -> get missing (404).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Project info",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/info",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "info"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Author is Taubakul Zhanibek Nurlanuly\", function () {",
              "    pm.expect(pm.response.json().author).to.eql(\"Taubakul Zhanibek Nurlanuly\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "1. Create a student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Zhanibek\",\n  \"lastName\": \"Taubakul\",\n  \"email\": \"{{studentEmail}}\",\n  \"groupName\": \"DevOps-2026\",\n  \"course\": 3\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/students",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// unique email, so the collection can be run many times without 409",
              "pm.collectionVariables.set(\"studentEmail\", \"zhanibek.taubakul.\" + Date.now() + \"@example.com\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Location header is present\", function () {",
              "    pm.response.to.have.header(\"Location\");",
              "});",
              "const student = pm.response.json();",
              "pm.collectionVariables.set(\"studentId\", student.id);",
              "pm.test(\"First name is Zhanibek\", function () {",
              "    pm.expect(student.firstName).to.eql(\"Zhanibek\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Get all students",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/students",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response is an array\", function () {",
              "    pm.expect(pm.response.json()).to.be.an(\"array\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Get the student by id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/students/{{studentId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "{{studentId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Returned the created student\", function () {",
              "    pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"studentId\")));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Update the student (PUT)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Zhanibek\",\n  \"lastName\": \"Taubakul\",\n  \"email\": \"{{studentEmail}}\",\n  \"groupName\": \"DevOps-2027\",\n  \"course\": 4\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/students/{{studentId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "{{studentId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Course updated to 4\", function () {",
              "    pm.expect(pm.response.json().course).to.eql(4);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Delete the student",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/students/{{studentId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "{{studentId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 204\", function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Get the deleted (nonexistent) student",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/students/{{studentId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "{{studentId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 404\", function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "pm.test(\"Error message says not found\", function () {",
              "    pm.expect(pm.response.json().message).to.include(\"not found\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Create with invalid data (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"\",\n  \"lastName\": \"Taubakul\",\n  \"email\": \"not-an-email\",\n  \"groupName\": \"DevOps-2026\",\n  \"course\": 9\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/students",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 400\", function () {",
              "    pm.response.to.have.status(400);",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "studentId",
      "value": ""
    },
    {
      "key": "studentEmail",
      "value": ""
    }
  ]
}
